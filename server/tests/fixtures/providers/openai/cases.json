    {
      "name": "tool_call",
      "note": "The same declaration as the Anthropic corpus's, and the same normalised call out the other side - which is the whole of D31's claim. The visible difference is that `arguments` crosses this wire as a **JSON string** and is an object at the port; providers.md section 8, rule 1.",
      "port_request": {
        "messages": [{"role": "user", "content": "Who is Mira related to?"}],
        "model": "gpt-4o-mini",
        "max_tokens": 1024,
        "tools": [
          {
            "name": "read_bible_entry",
            "description": "Read one story-bible entry by name.",
            "parameters": {
              "type": "object",
              "properties": {"name": {"type": "string"}},
              "required": ["name"]
            }
          }
        ],
        "tool_choice": "auto"
      },
      "wire_request": {
        "model": "gpt-4o-mini",
        "max_tokens": 1024,
        "messages": [{"role": "user", "content": "Who is Mira related to?"}],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "read_bible_entry",
              "description": "Read one story-bible entry by name.",
              "parameters": {
                "type": "object",
                "properties": {"name": {"type": "string"}},
                "required": ["name"]
              }
            }
          }
        ],
        "tool_choice": "auto"
      },
      "http_status": 200,
      "wire_response": {
        "id": "chatcmpl-9pR7TbKmWv3XqLd8ZnYc2Fj4",
        "object": "chat.completion",
        "created": 1756900002,
        "model": "gpt-4o-mini-2024-07-18",
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                {
                  "id": "call_8xLqR2mVbN4sWfTy",
                  "type": "function",
                  "function": {"name": "read_bible_entry", "arguments": "{\"name\":\"Mira\"}"}
                }
              ]
            },
            "logprobs": null,
            "finish_reason": "tool_calls"
          }
        ],
        "usage": {"prompt_tokens": 498, "completion_tokens": 18, "total_tokens": 516}
      },
      "port_result": {
        "text": "",
        "tool_calls": [
          {"id": "call_8xLqR2mVbN4sWfTy", "name": "read_bible_entry", "arguments": {"name": "Mira"}}
        ],
        "stop_reason": "tool_use",
        "raw_stop_reason": "tool_calls",
        "usage": {"input_tokens": 498, "output_tokens": 18}
      }
    },
    {
      "name": "local_server_streamed",
      "note": "The reason this adapter exists: a server that is only **nearly** compatible. Captured from a local llama.cpp-style server - no `system_fingerprint`, a file path where a model id goes, no usage at all because `stream_options` was turned off for it, and a stream that ends with `[DONE]` and nothing else. The port reports Usage() of zero, which means *not reported* rather than free, and the panel says so.",
      "stream": true,
      "adapter": {"stream_usage": false},
      "port_request": {
        "messages": [{"role": "user", "content": "Give me one sentence about the harbour."}],
        "model": "local-model",
        "max_tokens": 256
      },
      "wire_request": {
        "model": "local-model",
        "max_tokens": 256,
        "messages": [{"role": "user", "content": "Give me one sentence about the harbour."}],
        "stream": true
      },
      "http_status": 200,
      "sse": [
