    {
      "name": "auth_failure",
      "note": "The same condition as the Anthropic corpus's, in this protocol's error shape, mapping to the same code. That the two arrive identically at the port is the point of having a taxonomy at all.",
      "port_request": {
        "messages": [{"role": "user", "content": "Anything."}],
        "model": "gpt-4o-mini",
        "max_tokens": 256
      },
      "http_status": 401,
      "wire_response": {
        "error": {
          "message": "Incorrect API key provided: sk-wrong***. You can find your API key at https://platform.openai.com/account/api-keys.",
          "type": "invalid_request_error",
          "param": null,
          "code": "invalid_api_key"
        }
      },
      "port_error": {"code": "provider_auth_failed", "message_contains": "Incorrect API key provided"}
    },
    {
      "name": "rate_limited",
      "note": "A 429. Note the body says `insufficient_quota` while the status says rate limit: the status is read first and the body only refines it, because the servers that are nearly compatible are inconsistent about exactly this field.",
      "port_request": {
        "messages": [{"role": "user", "content": "Anything."}],
        "model": "gpt-4o-mini",
        "max_tokens": 256
      },
      "http_status": 429,
      "wire_response": {
        "error": {
          "message": "You exceeded your current quota, please check your plan and billing details.",
          "type": "insufficient_quota",
          "param": null,
          "code": "insufficient_quota"
        }
      },
      "port_error": {"code": "provider_rate_limited", "message_contains": "exceeded your current quota"}
    },
    {
      "name": "over_context",
      "note": "This protocol names the condition in `code`, which the Anthropic one does not - and the transport reads both the message and the code, so either signal is enough.",
      "port_request": {
        "messages": [{"role": "user", "content": "The whole manuscript, pasted."}],
        "model": "gpt-4o-mini",
        "max_tokens": 4096
      },
      "http_status": 400,
      "wire_response": {
        "error": {
          "message": "This model's maximum context length is 128000 tokens. However, your messages resulted in 190423 tokens. Please reduce the length of the messages.",
          "type": "invalid_request_error",
          "param": "messages",
          "code": "context_length_exceeded"
        }
      },
      "port_error": {"code": "context_too_large", "message_contains": "maximum context length"}
    }
