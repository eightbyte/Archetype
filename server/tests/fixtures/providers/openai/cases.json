    {
      "name": "streamed_completion",
      "note": "With `stream_options.include_usage` on, which is how this protocol reports usage on a streamed answer. The usage chunk has an empty `choices` list and arrives after the finish reason, so the port's single `usage` event lands between the last delta and `done`.",
      "stream": true,
      "port_request": {
        "messages": [{"role": "user", "content": "Give me one sentence about the harbour."}],
        "model": "gpt-4o-mini",
        "max_tokens": 256
      },
      "wire_request": {
        "model": "gpt-4o-mini",
        "max_tokens": 256,
        "messages": [{"role": "user", "content": "Give me one sentence about the harbour."}],
        "stream": true,
        "stream_options": {"include_usage": true}
      },
      "http_status": 200,
