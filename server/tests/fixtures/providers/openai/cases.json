        "",
        "data: {\"id\":\"chatcmpl-9pR1\",\"object\":\"chat.completion.chunk\",\"created\":1756900001,\"model\":\"gpt-4o-mini-2024-07-18\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\" all morning.\"},\"finish_reason\":null}]}",
