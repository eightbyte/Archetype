{
  "provider": "anthropic",
  "cases": [
    {
      "name": "plain_completion",
      "note": "The ordinary case. One system message and one question, a whole answer back. Note that the request carries no `temperature`: the port defaults it to None meaning the provider's own, and the current Claude models reject the parameter outright.",
      "port_request": {
        "messages": [
          {"role": "system", "content": "You are a careful reader of a novel in progress. Answer only from the passage you are given."},
          {"role": "user", "content": "Does this paragraph say how long Mira has been waiting?"}
        ],
        "model": "claude-opus-5",
        "max_tokens": 1024
      },
      "wire_request": {
        "model": "claude-opus-5",
        "max_tokens": 1024,
        "system": "You are a careful reader of a novel in progress. Answer only from the passage you are given.",
        "messages": [
          {"role": "user", "content": "Does this paragraph say how long Mira has been waiting?"}
        ]
      },
      "http_status": 200,
      "wire_response": {
        "id": "msg_01XfDuDYJgAACzvnptvVoYEL",
        "type": "message",
        "role": "assistant",
        "model": "claude-opus-5",
        "content": [
          {"type": "text", "text": "Not directly. It says the tea has gone cold twice, which implies a long wait without measuring it."}
        ],
        "stop_reason": "end_turn",
        "stop_sequence": null,
        "usage": {"input_tokens": 412, "output_tokens": 27}
      },
      "port_result": {
        "text": "Not directly. It says the tea has gone cold twice, which implies a long wait without measuring it.",
        "tool_calls": [],
        "stop_reason": "end_turn",
        "raw_stop_reason": "end_turn",
        "usage": {"input_tokens": 412, "output_tokens": 27}
      }
    },
    {
      "name": "streamed_completion",
      "note": "The same answer as it arrives. Two things this case pins: usage is reported in two halves (input at message_start, output at message_delta) and leaves as exactly one `usage` event; and `content_block_start`, `content_block_stop`, and `ping` produce nothing, because they are the provider's vocabulary and not the port's.",
      "stream": true,
      "port_request": {
        "messages": [
          {"role": "user", "content": "Give me one sentence about the harbour."}
        ],
        "model": "claude-opus-5",
        "max_tokens": 256
      },
      "wire_request": {
        "model": "claude-opus-5",
        "max_tokens": 256,
        "messages": [
          {"role": "user", "content": "Give me one sentence about the harbour."}
        ],
        "stream": true
      },
      "http_status": 200,
