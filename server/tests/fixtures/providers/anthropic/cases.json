    {
      "name": "tool_call",
      "note": "D31's consumer. Phase 4 declares no tools; this payload is the only thing proving the translation works before Phase 6 needs it. Both directions are asserted: the declaration goes out as `input_schema` with a `tool_choice` object, and the `tool_use` block comes back as a ToolCall whose arguments are already an object.",
      "port_request": {
        "messages": [
          {"role": "user", "content": "Who is Mira related to?"}
        ],
        "model": "claude-opus-5",
        "max_tokens": 1024,
        "tools": [
          {
            "name": "read_bible_entry",
            "description": "Read one story-bible entry by name.",
            "parameters": {
              "type": "object",
              "properties": {"name": {"type": "string"}},
              "required": ["name"]
            }
          }
        ],
        "tool_choice": "auto"
      },
      "wire_request": {
        "model": "claude-opus-5",
        "max_tokens": 1024,
        "messages": [
          {"role": "user", "content": "Who is Mira related to?"}
        ],
        "tools": [
          {
            "name": "read_bible_entry",
            "description": "Read one story-bible entry by name.",
            "input_schema": {
              "type": "object",
              "properties": {"name": {"type": "string"}},
              "required": ["name"]
            }
          }
        ],
        "tool_choice": {"type": "auto"}
      },
      "http_status": 200,
      "wire_response": {
        "id": "msg_01Bq4TzHkS8wRb2nVfLmQpXd",
        "type": "message",
        "role": "assistant",
        "model": "claude-opus-5",
        "content": [
