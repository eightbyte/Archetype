    {
      "name": "rate_limited",
      "note": "Its own code, because it is the one failure that is temporary and is not the writer's mistake. Nothing retries it (ruling 6): the autosave ladder is right there and is exactly wrong here.",
      "port_request": {
        "messages": [{"role": "user", "content": "Anything."}],
        "model": "claude-opus-5",
        "max_tokens": 256
      },
      "http_status": 429,
