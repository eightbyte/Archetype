    {
      "name": "over_context",
      "note": "The provider's own refusal for a prompt that will not fit. It arrives as an ordinary 400 with a sentence in it, which is why the transport reads the message rather than the status alone - and why our own budget check (P4-8) runs first and never guesses.",
      "port_request": {
        "messages": [{"role": "user", "content": "The whole manuscript, pasted."}],
        "model": "claude-opus-5",
        "max_tokens": 4096
      },
      "http_status": 400,
      "wire_response": {
        "type": "error",
        "error": {
          "type": "invalid_request_error",
          "message": "prompt is too long: 234567 tokens > 200000 maximum"
        },
        "request_id": "req_011CSHoGqRt7yVb1Xz8KmNpQ"
      },
      "port_error": {"code": "context_too_large", "message_contains": "prompt is too long"}
